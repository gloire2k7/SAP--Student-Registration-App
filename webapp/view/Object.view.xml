<mvc:View
    controllerName="student.registration.controller.Object"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:uxap="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">

    <uxap:ObjectPageLayout
        id="objectPage"
        showTitleInHeaderContent="false"
        alwaysShowContentHeader="false"
        headerContentPinnable="true"
        useIconTabBar="true"
        showAnchorBar="true">

        <uxap:headerTitle>
            <uxap:ObjectPageHeader
                objectTitle="{firstName} {lastName}"
                objectSubtitle="{program}"
                isObjectIconAlwaysVisible="true">
                <uxap:actions>
                    <Button text="Edit" icon="sap-icon://edit" press=".onEditPress"/>
                    <Button text="Email" icon="sap-icon://email" press=".onEmailPress"/>
                </uxap:actions>
            </uxap:ObjectPageHeader>
        </uxap:headerTitle>

        <uxap:headerContent>
            <layout:VerticalLayout class="sapUiSmallMargin">
                <Breadcrumbs currentLocationText="{firstName} {lastName}">
                    <Link text="Students" press=".onNavBack"/>
                </Breadcrumbs>

                <HBox alignItems="Center" class="sapUiSmallMarginTop">
                    <Avatar
                        src="{picture}"
                        fallbackIcon="sap-icon://person-placeholder"
                        displaySize="L"
                        class="sapUiSmallMarginEnd"
                        initials="{= (${firstName} || '?').substring(0,1) + (${lastName} || '?').substring(0,1) }"/>

                    <layout:VerticalLayout>
                        <HBox wrap="Wrap">
                            <ObjectStatus
                                text="Status: {status}"
                                state="{= ${status} === 'Active' ? 'Success' : 'Information' }"
                                class="sapUiSmallMarginEnd"/>
                            <ObjectStatus
                                text="Year {year}"
                                state="Information"
                                class="sapUiSmallMarginEnd"/>
                            <ObjectStatus
                                text="GPA {gpa}"
                                state="{= ${gpa} >= 3.5 ? 'Success' : 'Warning' }"
                                class="sapUiSmallMarginEnd"/>
                        </HBox>
                        <Text text="{email}" class="sapUiSmallMarginTop"/>
                    </layout:VerticalLayout>
                </HBox>
            </layout:VerticalLayout>
        </uxap:headerContent>

        <uxap:sections>

            <!-- 1. Personal Information -->
            <uxap:ObjectPageSection
                title="Personal Information"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <form:SimpleForm
                            editable="false"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4"
                            labelSpanL="4"
                            labelSpanM="4"
                            labelSpanS="12"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1">
                            <form:content>
                                <Label text="Student ID"/>
                                <Text text="{studentId}"/>

                                <Label text="First Name"/>
                                <Text text="{firstName}"/>

                                <Label text="Last Name"/>
                                <Text text="{lastName}"/>

                                <Label text="Email"/>
                                <Link text="{email}" href="mailto:{email}"/>

                                <Label text="Program"/>
                                <Text text="{program}"/>

                                <Label text="Year"/>
                                <Text text="{year}"/>

                                <Label text="Status"/>
                                <Text text="{status}"/>
                            </form:content>
                        </form:SimpleForm>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- 2. Academic Performance -->
            <uxap:ObjectPageSection
                title="Academic Performance"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <layout:HorizontalLayout class="sapUiSmallMargin">
                            <GenericTile
                                header="Current GPA"
                                subheader="{= ${gpa} >= 3.5 ? 'Dean\'s List' : 'Good Standing' }"
                                class="sapUiSmallMarginEnd">
                                <TileContent unit="of 4.0">
                                    <NumericContent
                                        value="{gpa}"
                                        valueColor="{= ${gpa} >= 3.5 ? 'Good' : 'Critical' }"
                                        scale=""/>
                                </TileContent>
                            </GenericTile>

                            <GenericTile
                                header="Year"
                                subheader="Currently enrolled">
                                <TileContent unit="of 4">
                                    <NumericContent value="{year}" valueColor="Neutral"/>
                                </TileContent>
                            </GenericTile>
                        </layout:HorizontalLayout>
                    </uxap:ObjectPageSubSection>

                    <uxap:ObjectPageSubSection title="Enrolled Courses">
                        <List
                            id="coursesList"
                            items="{courses>/items}"
                            noDataText="No courses enrolled"
                            class="sapUiSmallMargin">
                            <StandardListItem
                                title="{courses>name}"
                                icon="sap-icon://course-program"
                                info="Enrolled"
                                infoState="Success"/>
                        </List>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- 3. Documents -->
            <uxap:ObjectPageSection
                title="Documents"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <List
                            id="documentsList"
                            items="{registration/attachments}"
                            noDataText="No documents attached"
                            class="sapUiSmallMargin">
                            <StandardListItem
                                title="{fileName}"
                                description="{mimeType}"
                                info="{= ${size} ? Math.round(${size}/1024) + ' KB' : '' }"
                                icon="sap-icon://pdf-attachment"
                                type="Active"
                                press=".onDocumentPreview"/>
                        </List>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>