<mvc:View
    controllerName="student.registration.controller.Worklist"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    height="100%">

    <f:FlexibleColumnLayout
        id="worklistFcl"
        layout="{layout>/layout}"
        backgroundDesign="Solid"
        height="100%">

        <f:beginColumnPages>
            <f:DynamicPage
                id="masterPage"
                headerExpanded="true"
                toggleHeaderOnTitleClick="false"
                fitContainer="true">
                <f:title>
                    <f:DynamicPageTitle>
                        <f:navigationActions>
                            <Button icon="sap-icon://nav-back" type="Transparent"
                                    tooltip="Back" press=".onNavBack"/>
                        </f:navigationActions>
                        <f:heading>
                            <Title text="Pending Registrations" level="H2"/>
                        </f:heading>
                        <f:snappedContent>
                            <Text id="pendingCountSnapped" text=""/>
                        </f:snappedContent>
                        <f:expandedContent>
                            <Text id="pendingCountExpanded" text=""/>
                        </f:expandedContent>
                        <f:actions>
                            <Button text="New Registration" icon="sap-icon://add"
                                    type="Emphasized" press=".onNewRegistration"/>
                            <Button icon="sap-icon://refresh" tooltip="Refresh"
                                    type="Transparent" press=".onRefresh"/>
                            <Button text="Students" icon="sap-icon://employee"
                                    type="Transparent" press=".onViewStudents"/>
                        </f:actions>
                    </f:DynamicPageTitle>
                </f:title>

                <f:content>
                    <List
                        id="pendingList"
                        items="{
                            path: '/Registrations',
                            parameters: { $expand: 'attachments' },
                            filters: [{
                                path: 'status',
                                operator: 'EQ',
                                value1: 'Pending'
                            }]
                        }"
                        mode="SingleSelectMaster"
                        selectionChange=".onPendingSelect"
                        noDataText="No pending registrations">
                        <StandardListItem
                            title="{firstName} {lastName}"
                            description="{program}"
                            info="{submittedOn}"
                            infoState="{= ${documentsComplete} ? 'Success' : 'Warning' }"
                            icon="{= ${documentsComplete} ? 'sap-icon://accept' : 'sap-icon://alert' }"
                            type="Active"/>
                    </List>
                </f:content>
            </f:DynamicPage>
        </f:beginColumnPages>

        <f:midColumnPages>
            <f:DynamicPage
                id="detailPage"
                headerExpanded="true"
                toggleHeaderOnTitleClick="false"
                showFooter="true"
                fitContainer="true">

                <f:title>
                    <f:DynamicPageTitle>
                        <f:navigationActions>
                            <Button icon="sap-icon://nav-back" type="Transparent"
                                    tooltip="Close detail" press=".onCloseDetail"/>
                        </f:navigationActions>
                        <f:heading>
                            <Title text="{firstName} {lastName}" level="H2"/>
                        </f:heading>
                        <f:expandedContent>
                            <Text text="{program}"/>
                        </f:expandedContent>
                    </f:DynamicPageTitle>
                </f:title>

                <f:header>
                    <f:DynamicPageHeader pinnable="true">
                        <HBox wrap="Wrap" class="sapUiSmallMargin" alignItems="Center">
                            <ObjectStatus text="Submitted {submittedOn}"
                                          state="Information"
                                          class="sapUiSmallMarginEnd"/>
                            <ObjectStatus
                                text="{= ${documentsComplete} ? 'Documents Complete' : 'Documents Missing' }"
                                state="{= ${documentsComplete} ? 'Success' : 'Warning' }"
                                class="sapUiSmallMarginEnd"/>
                            <Button
                                id="previewDocBtn"
                                text="Preview Document"
                                icon="sap-icon://pdf-attachment"
                                type="Emphasized"
                                press=".onPreviewDocument"
                                visible="{detail>/hasAttachments}"/>
                        </HBox>
                    </f:DynamicPageHeader>
                </f:header>

                <f:content>
                    <MessageStrip
                        text="{= ${documentsComplete} ? 'All documents received' : 'Missing documents — cannot approve yet' }"
                        type="{= ${documentsComplete} ? 'Success' : 'Warning' }"
                        showIcon="true"
                        class="sapUiSmallMargin"/>

                    <form:SimpleForm
                        editable="false"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                        class="sapUiSmallMargin">
                        <form:content>
                            <Label text="Application ID"/>
                            <Text text="{studentId}"/>

                            <Label text="Email"/>
                            <Link text="{email}" href="mailto:{email}"/>

                            <Label text="Program"/>
                            <Text text="{program}"/>

                            <Label text="Intended Year"/>
                            <Text text="{year}"/>

                            <Label text="Submitted On"/>
                            <Text text="{submittedOn}"/>

                            <Label text="Notes"/>
                            <Text text="{notes}"/>
                        </form:content>
                    </form:SimpleForm>
                </f:content>

                <f:footer>
                    <OverflowToolbar>
                        <ToolbarSpacer/>
                        <Button
                            id="rejectBtn"
                            text="Reject"
                            type="Reject"
                            icon="sap-icon://decline"
                            press=".onReject"/>
                        <Button
                            id="approveBtn"
                            text="Approve"
                            type="Accept"
                            icon="sap-icon://accept"
                            press=".onApprove"/>
                    </OverflowToolbar>
                </f:footer>
            </f:DynamicPage>
        </f:midColumnPages>
    </f:FlexibleColumnLayout>
</mvc:View>