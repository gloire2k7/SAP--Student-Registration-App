<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:html="http://www.w3.org/1999/xhtml">

  <Dialog
    id="pdfViewerDialog"
    title="Document Preview"
    contentWidth="70%"
    contentHeight="85%"
    stretch="{device>/isPhone}"
    draggable="true"
    resizable="true"
    afterClose=".onAfterClosePdfDialog">

    <content>
      <!-- Error strip -->
      <MessageStrip
        id="pdfErrorStrip"
        text="{pdf>/errorMessage}"
        type="Error"
        showIcon="true"
        visible="{pdf>/error}"
        class="sapUiSmallMargin"/>

      <!-- Loading indicator -->
      <VBox
        id="pdfLoadingBox"
        alignItems="Center"
        justifyContent="Center"
        height="100%"
        width="100%"
        visible="{pdf>/loading}">
        <BusyIndicator size="2rem" text="Loading PDF..."/>
      </VBox>

      <!-- Native iframe: browser's built-in PDF viewer -->
      <html:iframe
        id="pdfFrame"
        src="{pdf>/source}"
        style="width:100%; height:100%; border:0; display:block;"
        visible="{= !${pdf>/loading} &amp;&amp; !${pdf>/error} }"/>
    </content>

    <beginButton>
      <Button
        text="Open in new tab"
        icon="sap-icon://action"
        press=".onOpenPdfInNewTab"
        enabled="{= !${pdf>/loading} &amp;&amp; !${pdf>/error} }"/>
    </beginButton>

    <endButton>
      <Button
        text="Close"
        press=".onClosePdfDialog"/>
    </endButton>

  </Dialog>
</core:FragmentDefinition>