<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="pdfViewerDialog"
    title="Document Preview"
    contentWidth="85%"
    contentHeight="90%"
    stretch="{device>/isPhone}"
    draggable="true"
    resizable="true"
    afterClose=".onAfterClosePdfDialog">

    <content>
      <MessageStrip
        id="pdfErrorStrip"
        text="{pdf>/errorMessage}"
        type="Error"
        showIcon="true"
        visible="{pdf>/error}"
        class="sapUiSmallMargin"/>

      <VBox
        id="pdfLoadingBox"
        height="80vh"
        width="100%"
        alignItems="Center"
        justifyContent="Center"
        visible="{pdf>/loading}">
        <BusyIndicator size="2rem" text="Loading PDF..."/>
      </VBox>

      <!--
        THIS is the container that gives the iframe a real height.
        The VBox is what we measure in the console — its DOM id is
        "pdfContainer" (child of the dialog).
      -->
      <VBox
        id="pdfContainer"
        height="80vh"
        width="100%"
        visible="{= !${pdf>/loading} &amp;&amp; !${pdf>/error} }">
        <core:HTML
          id="pdfFrame"
          content="{path: 'pdf>/source', formatter: '.formatPdfFrame'}"
          preferDOM="true"/>
      </VBox>
    </content>

    <beginButton>
      <Button
        text="Open in new tab"
        icon="sap-icon://action"
        press=".onOpenPdfInNewTab"
        enabled="{= !${pdf>/loading} &amp;&amp; !${pdf>/error} }"/>
    </beginButton>

    <endButton>
      <Button text="Close" press=".onClosePdfDialog"/>
    </endButton>

  </Dialog>
</core:FragmentDefinition>