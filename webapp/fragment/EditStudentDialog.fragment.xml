<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:u="sap.ui.unified">

    <Dialog
        id="editStudentDialog"
        title="Edit Student"
        contentWidth="40rem"
        draggable="true"
        resizable="true">

        <content>
            <MessageStrip
                id="errorSummary"
                text=""
                type="Error"
                showIcon="true"
                visible="false"
                class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"/>

            <form:SimpleForm
                id="studentForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                columnsXL="1"
                columnsL="1"
                columnsM="1">

                <form:content>
                    <!-- ========== Profile Picture ========== -->
                    <Label text="Profile Picture"/>
                    <VBox>
                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                            <Avatar
                                id="picturePreview"
                                src="{edit>/picture}"
                                displaySize="M"
                                class="sapUiSmallMarginEnd"
                                initials="{= (${edit>/firstName} || '').substring(0,1) + (${edit>/lastName} || '').substring(0,1) }"/>

                            <VBox>
                                <u:FileUploader
                                    id="pictureUploaderEdit"
                                    name="picture"
                                    width="20rem"
                                    placeholder="Choose a new picture (max 500 KB)"
                                    fileType="jpg,png,jpeg"
                                    buttonText="Change Picture"
                                    maximumFileSize="0.5"
                                    change=".onEditPictureChange"
                                    fileSizeExceed=".onEditPictureSizeExceed"/>
                                <Text
                                    text="{edit>/pictureFileName}"
                                    class="sapUiSmallMarginTop"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ========== Existing fields ========== -->
                    <Label text="First Name" required="true"/>
                    <Input
                        id="firstNameInput"
                        value="{edit>/firstName}"
                        placeholder="First name"
                        liveChange=".onValidateField"/>

                    <Label text="Last Name" required="true"/>
                    <Input
                        id="lastNameInput"
                        value="{edit>/lastName}"
                        placeholder="Last name"
                        liveChange=".onValidateField"/>

                    <Label text="Email" required="true"/>
                    <Input
                        id="emailInput"
                        value="{edit>/email}"
                        type="Email"
                        placeholder="student@uni.edu"
                        liveChange=".onValidateField"/>

                    <Label text="Program"/>
                    <Input
                        id="programInput"
                        value="{edit>/program}"
                        placeholder="e.g. Computer Science"/>

                    <Label text="Year" required="true"/>
                    <Input
                        id="yearInput"
                        value="{edit>/year}"
                        type="Number"
                        placeholder="1 to 4"
                        liveChange=".onValidateField"/>

                    <Label text="GPA" required="true"/>
                    <Input
                        id="gpaInput"
                        value="{edit>/gpa}"
                        type="Number"
                        placeholder="0.0 to 4.0"
                        liveChange=".onValidateField"/>
                </form:content>
            </form:SimpleForm>
        </content>

        <beginButton>
            <Button
                id="saveBtn"
                text="Save"
                type="Emphasized"
                enabled="false"
                press=".onSaveStudent"/>
        </beginButton>

        <endButton>
            <Button
                id="cancelBtn"
                text="Cancel"
                press=".onCancelEdit"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>