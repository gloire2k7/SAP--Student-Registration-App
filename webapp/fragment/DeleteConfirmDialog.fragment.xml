<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="deleteConfirmDialog"
    title="Confirm Delete"
    type="Message"
    contentWidth="26rem"
    draggable="true">

    <content>
      <MessageStrip
        id="deleteMessage"
        text="Are you sure you want to delete the student?"
        type="Warning"
        showIcon="true"
        class="sapUiSmallMargin"/>
    </content>

    <beginButton>
      <Button
        id="confirmDeleteBtn"
        text="Delete"
        type="Reject"
        press=".onConfirmDelete"/>
    </beginButton>
    <endButton>
      <Button
        text="Cancel"
        press=".onCancelDelete"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>